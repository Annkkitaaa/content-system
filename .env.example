# Copy to .env and fill in. .env is gitignored and must stay that way.
# Every value here has a working default, so an empty .env is valid.

# --- Model access ---------------------------------------------------------
# agent_sdk  runs on your Claude subscription, no API key needed
# anthropic  uses the Messages API, needs credit at console.anthropic.com
# mock       deterministic and offline, for tests and dry runs
CONTENTSYS_PROVIDER=agent_sdk

# Only read by the anthropic provider. Leave empty when using agent_sdk.
CONTENTSYS_ANTHROPIC_API_KEY=

CONTENTSYS_GENERATION_MODEL=claude-opus-5
CONTENTSYS_EVALUATION_MODEL=claude-sonnet-5
CONTENTSYS_GENERATION_EFFORT=high
CONTENTSYS_EVALUATION_EFFORT=low

# --- Storage and output ---------------------------------------------------
CONTENTSYS_DATABASE_URL=sqlite:///data/contentsys.db
CONTENTSYS_EXPORT_DIR=exports

# --- Scheduling -----------------------------------------------------------
# Any IANA timezone name.
CONTENTSYS_TIMEZONE=Asia/Kolkata

# --- Generation -----------------------------------------------------------
# Generate this multiple of the needed ideas, then keep only the strongest.
CONTENTSYS_IDEA_OVERSAMPLE=2.0
